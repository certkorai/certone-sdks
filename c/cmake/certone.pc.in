prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: certone
Description: CertOne control-plane C SDK
Version: @PROJECT_VERSION@
Requires.private: libcurl >= 7.56
Libs: -L${libdir} -lcertone
Cflags: -I${includedir}
